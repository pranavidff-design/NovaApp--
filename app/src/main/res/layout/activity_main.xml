<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nova_bg_bottom"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOVA"
        android:textColor="@color/nova_text"
        android:textSize="16sp"
        android:letterSpacing="0.2"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- The orb: tap to talk. Reacts to state (idle/listening/thinking/speaking/
         wake-active/paused/error) — see NovaOrbView. -->
    <com.nova.assistant.NovaOrbView
        android:id="@+id/orbContainer"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/statusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:text="@string/status_idle"
        android:textColor="@color/nova_text_dim"
        android:textSize="13sp" />

    <Button
        android:id="@+id/memoryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:text="Memory" />

    <Button
        android:id="@+id/routinesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="Routines" />

    <Button
        android:id="@+id/pauseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="Pause Nova" />

    <Button
        android:id="@+id/wakeWordButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="Wake word: OFF" />

    <Button
        android:id="@+id/loadModelButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="Load AI Model" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:background="@color/nova_panel"
        android:padding="14dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nova_text"
            android:textSize="13.5sp"
            android:lineSpacingExtra="6dp"
            android:text="Nova is ready." />

    </ScrollView>

</LinearLayout>
